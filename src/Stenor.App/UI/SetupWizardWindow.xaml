<Window x:Class="Stenor.UI.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Stenor.UI"
        Title="Stenor Setup"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextDecorations="Underline" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Intro" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,5,0,0" />
        </Style>
        <Style x:Key="Status" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="ChecklistRow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="28,16,28,22">

        <!-- Header: progress dots, step caption, step title -->
        <StackPanel DockPanel.Dock="Top">
            <StackPanel x:Name="StepDots" Orientation="Horizontal" />
            <TextBlock x:Name="StepCaption" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Margin="0,10,0,2" />
            <TextBlock x:Name="StepTitle" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
        </StackPanel>

        <!-- Footer: skip on the left, back/next on the right -->
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="FooterErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            <Grid Margin="0,18,0,0">
                <Button x:Name="SkipButton" Style="{StaticResource LinkButton}" Content="Skip this step"
                        HorizontalAlignment="Left" Click="OnSkip" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Style="{StaticResource DarkButton}" Content="Back"
                            Width="92" Click="OnBack" />
                    <Button x:Name="NextButton" Style="{StaticResource AccentButton}" Content="Next"
                            MinWidth="132" Margin="10,0,0,0" Click="OnNext" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Body: one panel per step -->
        <Grid MinHeight="230">

            <StackPanel x:Name="ApiKeyStep">
                <TextBlock Style="{StaticResource Intro}"
                           Text="Stenor turns your speech into text with Google Gemini, using your own API key. The key is stored encrypted on this computer and is never sent anywhere else." />
                <TextBlock Text="Gemini API key" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource DarkPasswordBox}"
                                 PasswordChanged="OnApiKeyChanged" />
                    <TextBox x:Name="ApiKeyVisibleBox" Style="{StaticResource DarkTextBox}"
                             Visibility="Collapsed" TextChanged="OnApiKeyChanged" />
                    <Button x:Name="ToggleKeyVisibilityButton" Grid.Column="1" Style="{StaticResource DarkButton}"
                            Content="Show" Width="64" Margin="8,0,0,0" Click="OnToggleKeyVisibility" />
                </Grid>
                <TextBlock Margin="0,8,0,0" FontSize="12">
                    <Hyperlink NavigateUri="https://aistudio.google.com/apikey"
                               RequestNavigate="OnNavigate"
                               Foreground="{StaticResource AccentBrush}">Get a free key → aistudio.google.com/apikey</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="KeyResultText" Style="{StaticResource Status}" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel x:Name="MicrophoneStep" Visibility="Collapsed">
                <TextBlock x:Name="DeviceText" Style="{StaticResource Intro}" />
                <TextBlock FontSize="14" Margin="0,10,0,12" TextWrapping="Wrap"
                           Text="Say a sentence out loud, for example: “Testing, one, two, three.”" />
                <Border x:Name="LevelTrack" Height="12" CornerRadius="6"
                        Background="{StaticResource ControlBrush}"
                        BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1">
                    <Border x:Name="LevelFill" HorizontalAlignment="Left" CornerRadius="5" Width="0"
                            Background="{StaticResource AccentBrush}" />
                </Border>
                <TextBlock x:Name="MicStatusText" Style="{StaticResource Status}" />
                <TextBlock x:Name="MicTipsText" Style="{StaticResource Hint}" Visibility="Collapsed"
                           Margin="2,8,0,0"
                           Text="Check that the microphone is not muted, that the right device is the Windows default (Settings › System › Sound › Input), and that apps are allowed to use it (Settings › Privacy &amp; security › Microphone)." />
                <Button x:Name="MicRetryButton" Style="{StaticResource DarkButton}" Content="Try again"
                        HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed" Click="OnMicRetry" />
            </StackPanel>

            <StackPanel x:Name="HotkeyStep" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Intro}"
                           Text="This key starts dictation in any app. A single key such as the default Right Ctrl works best; a combination like Ctrl + Shift + D works too." />
                <TextBlock Text="Hotkey" Style="{StaticResource FieldLabel}" />
                <ui:HotkeyCaptureButton x:Name="HotkeyPicker" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Click, then press the key or combo you want (Esc cancels)." />
                <TextBlock Text="Activation mode" Style="{StaticResource FieldLabel}" />
                <RadioButton x:Name="HoldRadio" Style="{StaticResource DarkRadio}" GroupName="WizardMode"
                             Content="Hold — record while the hotkey is held (push-to-talk)" />
                <RadioButton x:Name="ToggleRadio" Style="{StaticResource DarkRadio}" GroupName="WizardMode"
                             Content="Toggle — press to start, press again to stop" />
            </StackPanel>

            <StackPanel x:Name="TrialStep" Visibility="Collapsed">
                <TextBlock Text="Languages you dictate in (optional)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <ui:LanguagePicker x:Name="Languages" />
                <TextBlock x:Name="TrialInstruction" FontSize="14" Margin="0,16,0,10" TextWrapping="Wrap" />
                <TextBox x:Name="TrialBox" Style="{StaticResource DarkTextBox}" Height="72"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         TextChanged="OnTrialTextChanged" />
                <StackPanel Margin="0,14,0,0">
                    <TextBlock x:Name="HotkeyRow" Style="{StaticResource ChecklistRow}" />
                    <TextBlock x:Name="RecordingRow" Style="{StaticResource ChecklistRow}" />
                    <TextBlock x:Name="TranscribingRow" Style="{StaticResource ChecklistRow}" />
                    <TextBlock x:Name="InsertedRow" Style="{StaticResource ChecklistRow}" />
                </StackPanel>
                <TextBlock x:Name="TrialResultText" Style="{StaticResource Status}" Margin="0,4,0,0"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel x:Name="DoneStep" Visibility="Collapsed">
                <TextBlock x:Name="DoneHeadline" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,14" />
                <TextBlock x:Name="SummaryKey" Style="{StaticResource ChecklistRow}" />
                <TextBlock x:Name="SummaryMic" Style="{StaticResource ChecklistRow}" />
                <TextBlock x:Name="SummaryHotkey" Style="{StaticResource ChecklistRow}" />
                <TextBlock x:Name="SummaryTrial" Style="{StaticResource ChecklistRow}" />
                <CheckBox x:Name="StartupCheck" Style="{StaticResource DarkCheckBox}" Margin="0,16,0,0"
                          Content="Start Stenor with Windows" />
                <TextBlock Style="{StaticResource Hint}" Margin="2,14,0,0"
                           Text="Everything can be changed later in Settings (double-click the tray icon). This setup can be run again from the tray menu: Set up &amp; test…" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
